    "No matching app container is available on this device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机没有匹配的应用容器。"
          }
        }
      }
    },
    "Close the target app first. Its current data receives a safety backup before restoration. App backups contain container files, not a complete device backup." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先关闭目标应用。恢复前会为当前数据创建安全备份。应用备份仅包含容器文件，并非完整设备备份。"
          }
        }
      }
    },
    "Some files could not be read. Refresh the scan before cleaning." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分文件无法读取，请重新扫描后再清理。"
          }
        }
      }
    },
    "This operation contains a symbolic link or unsupported file and was stopped." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到符号链接或不支持的文件，操作已停止。"
          }
        }
      }
    },
    "The app changed its files during this operation. Close it and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作期间应用文件发生变化，请关闭目标应用后重试。"
          }
        }
      }
    },
    "The backup is incomplete, damaged, or has been changed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份不完整、已损坏或已被修改。"
          }
        }
      }
    },
    "This backup does not belong to the selected application." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份不属于所选应用。"
          }
        }
      }
    },
    "Wait for the current app data operation to finish." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等待当前应用数据操作完成。"
          }
        }
      }
    },
    "An interrupted cache operation needs recovery. Its backup and staged files have been preserved." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断的缓存操作需要恢复，备份和暂存文件均已保留。"
          }
        }
      }
    },
    "Veilpath cannot clean or back up its own active data container here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
