{
  "sourceLanguage" : "en",
  "strings" : {
    "After you take a screenshot in Vellune, show quick actions to share it or report an issue." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 Vellune 中截屏后，显示分享截图或反馈问题的快捷操作。" } }
      }
    },
    "Closes the screenshot actions." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭截屏快捷操作。" } }
      }
    },
    "GitHub reports include app and system versions. Review screenshots for sensitive information before attaching them." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 反馈会包含 App 与系统版本。附加截图前，请检查其中是否包含敏感信息。" } }
      }
    },
    "Report Issue" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "反馈问题" } }
      }
